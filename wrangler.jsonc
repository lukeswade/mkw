{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mkw",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  // Keep the mkw.lukeswade.workers.dev fallback alive. Wrangler treats this
  // config as the source of truth, so with `routes` set and this omitted it
  // disables the workers.dev route on every deploy — silently undoing the
  // dashboard toggle and leaving mattkwade.com as the only way in.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mattkwade.com",
      "custom_domain": true
    }
  ]
}
