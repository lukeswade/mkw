# Copy to .env (never committed) and fill in what you need. Everything here
# can also be set later on the web Settings page, which stores values in
# ./data/settings.json (chmod 600). Settings-page values override this file.
#
# The only required setting is an LLM: either a DeepSeek key, or a local
# OpenAI-compatible server.

# --- Option A: cloud LLM (DeepSeek) ---------------------------------------
# Create a key at https://platform.deepseek.com → API keys
DEEPSEEK_API_KEY=

# --- Option B: local LLM (LM Studio, llama.cpp, Ollama, MLX …) -------------
# Anything that speaks the OpenAI chat-completions API. Uncomment to use.
# Models that support strict json_schema output (LM Studio, recent llama.cpp)
# are strongly preferred — the pipeline uses it to guarantee parseable output.
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://host.docker.internal:1234/v1
# LOCAL_LLM_MODEL=your-model-id
# LOCAL_LLM_API_KEY=sk-local
# One request at a time is right for a single local GPU:
# LLM_CONCURRENCY=1        # raise to 3-4 if your server batches (oMLX, vLLM, llama.cpp)

# --- Web UI ---------------------------------------------------------------
# Password for the web UI. Blank = no login page, which is only sensible if
# the app is reachable from nowhere but your own machine.
WEB_PASSWORD=
# Label for runs started from the local network (tunneled runs are tagged
# with the signed-in Cloudflare Access identity automatically)
# LAN_USER_LABEL=Luke

# --- Telegram bot (optional — the app runs web-only without it) ------------
# Token from @BotFather. Then message the bot /id and put the number below
# (comma-separated if more than one person should have access).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- SearXNG --------------------------------------------------------------
# Cookie secret for the bundled search engine. Generate one with:
#   openssl rand -hex 32
SEARXNG_SECRET=

# --- Cloudflare Tunnel (optional) -----------------------------------------
# Only needed with `docker compose --profile tunnel up -d`. Put a Cloudflare
# Access policy in front of the hostname as well.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Embeddings (optional) ------------------------------------------------
# Library semantic search, the Ask page, prior-knowledge injection and
# similar-run detection all run on embeddings. By default a small model
# (bge-small) baked into the image handles them, fully offline.
# Naming a model here routes embeddings to an OpenAI-compatible /embeddings
# endpoint instead — worthwhile if your local server already hosts a stronger
# retrieval model. Blank URL/key reuse the LLM endpoint's.
# Switching models starts a fresh vector index; run `cli reindex` to refill it.
# EMBEDDING_MODEL=nomicai-modernbert-embed-base-bf16
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# --- Tuning (optional) ----------------------------------------------------
# SearXNG categories to query. 'general' alone is Google/Brave/DuckDuckGo/
# Startpage, which all rate-limit or CAPTCHA under research traffic; science
# and it add Crossref, OpenAlex, Semantic Scholar, arXiv, Stack Overflow and
# GitHub, which don't.
# SEARCH_CATEGORIES=general,science   # recommended; `it` answers repair questions with package registries
# SEARCH_CONCURRENCY=2      # simultaneous SearXNG queries; higher trips limits
# RELEVANCE_THRESHOLD=4     # 0-10; sources scoring below this are discarded
# REFERENCE_CHASING=false   # also fetch references cited by kept sources (capped 4/round, 6/run)
# BLOCKED_DOMAINS=          # comma-separated domains never fetched (pinterest.com,…)
# Sites full of authoritative primary documents that search engines barely
# index; the planner aims site:-scoped queries at them when the topic fits.
# AUTHORITY_SITES=charm.li — full factory service manuals for cars and trucks
# FETCH_CONCURRENCY=8
# RESPECT_ROBOTS=false    # true also honours crawler directives
# USER_AGENT=...           # defaults to a browser UA; many CDNs 403 unknown clients
# BROWSER_IMPERSONATION=true  # retry refused fetches with a real Chrome TLS fingerprint
# Headless-browser fallback for JavaScript bot challenges. Start the sidecar
# with `docker compose --profile browser up -d`, then point at it:
# BROWSER_SOLVER_URL=http://flaresolverr:8191

# --- Search API keys (optional) ---------------------------------------------
# Each key present adds its engine to SearXNG at container start; absent keys
# change nothing. These never enter settings.yml, which is committed.
#
# Brave Search API — https://api-dashboard.search.brave.com/  ($5/1,000
# requests, $5 free credit monthly. It is POSTPAID: set a usage limit in the
# dashboard before generating a key.)
# BRAVE_API_KEY=
#
# Marginalia — free non-commercial key by email to contact@marginalia-search.com
# MARGINALIA_API_KEY=

# LLM_CALL_CEILING=600   # hard seconds cap on ONE model call (runaway local model)
