# Copy to .env (never committed) and fill in. Everything here can also be set
# later on the web Settings page, which stores values in ./data/settings.json
# (chmod 600). Settings-page values override this file.

# --- Cloud LLM (DeepSeek) -----------------------------------------------
# Create a key at https://platform.deepseek.com → API keys
DEEPSEEK_API_KEY=

# --- Telegram bot (optional — app runs web-only without it) --------------
# Token from @BotFather. Then message the bot /id and put your numeric user
# id below (comma-separated if several people may use it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Web UI ---------------------------------------------------------------
# Optional single password for the web UI. Blank = no login page.
WEB_PASSWORD=

# --- SearXNG ---------------------------------------------------------------
# Cookie secret for the bundled SearXNG (any random string):
#   openssl rand -hex 32
SEARXNG_SECRET=

# --- Local LLM instead of DeepSeek (optional) ------------------------------
# Run a llama.cpp server (or any OpenAI-compatible endpoint) and switch:
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://host.docker.internal:8080/v1
# LOCAL_LLM_MODEL=qwen2.5-32b-instruct
